#!/bin/sh
# Pre-push hook: run database seed before every push
# Best-effort: warns on failure but never blocks the push.

SERVER_DIR="$(git rev-parse --show-toplevel)/server"

if [ ! -f "$SERVER_DIR/package.json" ]; then
  exit 0
fi

cd "$SERVER_DIR" || exit 0

if [ ! -d "node_modules" ]; then
  echo "[githooks] seed skipped: node_modules not found (run npm install first)"
  exit 0
fi

echo "[githooks] running database seed..."
npx prisma db seed 2>&1 || echo "[githooks] seed warning: unable to run (DB available?)"
